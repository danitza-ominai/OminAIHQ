{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ominai.dev/contracts/runtime/task.schema.json",
  "title": "Tarea de Runtime de OminAI HQ",
  "description": "Contrato de tarea de runtime para ejecucion secuencial por agentes. Cumple con CONTRATO-MVP-v1.md secciones 5.1, 5.3 y 5.5-5.9. Rechaza campos de Chain-of-Thought y mantiene control estricto de limites y dependencias.",
  "$defs": {
    "schema_version": {
      "const": "1.0.0"
    },
    "agent_role": {
      "type": "string",
      "enum": [
        "chief_of_staff",
        "research_evidence_analyst",
        "product_architect",
        "delivery_planner",
        "governance_risk"
      ],
      "description": "Cinco roles reales autorizados en secuencia fija."
    },
    "task_state": {
      "type": "string",
      "enum": [
        "PENDIENTE",
        "LISTA",
        "EN_CURSO",
        "COMPLETA",
        "PARCIAL",
        "BLOQUEADA",
        "FALLIDA",
        "CANCELADA"
      ],
      "description": "Estados de tarea de la maquina de estados nuclear."
    },
    "task_category": {
      "type": "string",
      "enum": [
        "determinista",
        "razonamiento"
      ],
      "description": "Naturaleza de la tarea para control determinista."
    },
    "tool_category": {
      "type": "string",
      "enum": [
        "recuperacion_interna_solo_lectura",
        "investigacion_externa_solo_lectura",
        "transformacion_determinista",
        "analisis_especializado",
        "gestion_artefactos_internos",
        "accion_externa_sensible"
      ],
      "description": "Categorias funcionales de herramientas autorizadas."
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "mission_id",
    "mission_version",
    "agent_role",
    "objective",
    "question",
    "authorized_context",
    "approved_decisions",
    "structured_inputs",
    "expected_output",
    "allowed_tool_categories",
    "prohibitions",
    "limits",
    "escalation_rules",
    "category",
    "dependencies",
    "status",
    "attempt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador unico de la tarea dentro de la mision."
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador de la mision a la que pertenece la tarea."
    },
    "mission_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version del registro de la mision asociada."
    },
    "agent_role": {
      "$ref": "#/$defs/agent_role"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "Objetivo y responsabilidad verificable de la tarea."
    },
    "question": {
      "type": "string",
      "description": "Pregunta o instruccion focalizada que el agente debe resolver."
    },
    "authorized_context": {
      "type": "object",
      "required": [
        "brief_version",
        "input_refs",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "brief_version": {
          "type": "integer",
          "minimum": 1
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "description": "Contexto autorizado mediante referencias especificas, evitando volcados indiscriminados."
    },
    "approved_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Decisiones humanas o normativas aprobadas aplicables a esta tarea.",
      "uniqueItems": true
    },
    "structured_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "focus": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "description": "Entrada minima de esta pieza: foco textual opcional. No acepta contenedores arbitrarios; otras entradas necesitan contrato versionado."
    },
    "expected_output": {
      "type": "object",
      "required": [
        "description",
        "acceptance_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Definicion de salida esperada y criterios de aceptacion no vacios."
    },
    "allowed_tool_categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_category"
      },
      "description": "Categorias de herramientas expresamente autorizadas para esta tarea.",
      "uniqueItems": true
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Acciones y datos expresamente fuera de alcance."
    },
    "limits": {
      "type": "object",
      "required": [
        "max_attempts",
        "max_seconds",
        "max_budget_usd",
        "max_depth",
        "max_breadth"
      ],
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        },
        "max_depth": {
          "type": "integer",
          "const": 0,
          "description": "Descomposicion recursiva: cero en v0."
        },
        "max_breadth": {
          "type": "integer",
          "const": 1,
          "description": "Un especialista simultaneo; no habilita paralelismo."
        }
      },
      "description": "Techos de 11.4; el presupuesto por tarea no renueva el presupuesto global de USD 25. No mide gasto ni ejecuta."
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Condiciones para detener la ejecucion y solicitar decision o escalamiento."
    },
    "category": {
      "$ref": "#/$defs/task_category"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Lista de identificadores de tareas previas de las que depende esta tarea.",
      "uniqueItems": true
    },
    "status": {
      "$ref": "#/$defs/task_state"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "description": "Numero de intento actual de la tarea.",
      "maximum": 2
    }
  },
  "$comment": "PZ-003C correccion 1. Validacion estructural no prueba referencias. RuntimeContractsValidator exige contexto en memoria para integridad; no ejecuta ni aprueba."
}
