    "EN_CURSO":   { "terminal": false, "description": "Tarea en ejecucion activa." },
    "COMPLETA":   { "terminal": true,  "description": "Tarea finalizada exitosamente." },
    "PARCIAL":    { "terminal": true,  "description": "Tarea con resultado parcial y limitacion explicita." },
    "BLOQUEADA":  { "terminal": false, "description": "Tarea bloqueada por dependencia, recurso o error." },
    "FALLIDA":    { "terminal": true,  "description": "Tarea fallida. No se convierte automaticamente en COMPLETA por un reintento." },
    "CANCELADA":  { "terminal": true,  "description": "Tarea cancelada." }
  },
