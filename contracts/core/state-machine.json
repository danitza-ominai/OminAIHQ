  "referential_integrity_rules": {
    "description": "Reglas estructuradas de integridad referencial. JSON Schema valida formato e identidad de cada campo referencial. La verificacion de existencia real de los registros referenciados requiere validacion determinista entre registros implementada por el runtime. Una referencia no nula ausente produce NOT_FOUND y detiene la transicion dependiente.",
    "rules": [
      {
        "id": "RI-001",
        "field": "mission.approval_refs[]",
        "references": "approval.approval_id",
        "cardinality": "cero o mas",
        "on_missing_non_null": {
          "error_code": "NOT_FOUND",
          "effect": "detener_transicion_dependiente",
          "description": "Si approval_refs contiene un identificador que no existe en el conjunto de registros de aprobacion, se produce NOT_FOUND y la transicion que requiere esa aprobacion no puede ejecutarse."
        }
      },
      {
        "id": "RI-002",
        "field": "mission.last_checkpoint_id",
        "references": "checkpoint.checkpoint_id",
        "cardinality": "cero o uno",
        "on_missing_non_null": {
          "error_code": "NOT_FOUND",
          "effect": "detener_reanudacion",
          "description": "Si last_checkpoint_id no es null y no existe en el conjunto de registros de checkpoint, se produce NOT_FOUND y la reanudacion de la mision no puede ejecutarse."
        }
      },
      {
        "id": "RI-003",
        "field": "checkpoint.authorizations[]",
        "references": "approval.approval_id",
        "cardinality": "cero o mas",
        "on_missing_non_null": {
          "error_code": "NOT_FOUND",
          "effect": "detener_transicion_dependiente",
          "description": "Si authorizations contiene un identificador que no existe en el conjunto de registros de aprobacion, se produce NOT_FOUND y la transicion que requiere esa autorizacion no puede ejecutarse."
        }
      }
    ],
    "note": "No implementa persistencia. La verificacion se realiza contra el conjunto de registros en memoria disponible en cada operacion."
  },
  "approval_lifecycle": {
    "description": "Ciclo de vida estructurado de una aprobacion. CONSUMIDA y EXPIRADA son terminales sin transiciones de salida. La prevencion de doble respuesta (que un registro CONSUMIDA reciba una segunda decision) se aplica mediante este ciclo de vida determinista entre registros, no por JSON Schema solo.",
    "states": {
      "PENDIENTE":  { "terminal": false, "description": "Esperando decision del usuario humano." },
      "CONSUMIDA":  { "terminal": true,  "description": "El usuario humano emitio una decision. No regresa a PENDIENTE. No puede recibir segunda decision." },
      "EXPIRADA":   { "terminal": true,  "description": "La fecha de expiracion se alcanzo sin decision. No puede ser respondida ni pasar a CONSUMIDA." }
    },
    "transitions": [
      {
        "id": "AT-001",
        "from": "PENDIENTE",
        "to": "CONSUMIDA",
        "event": "decision_emitida",
        "guard": "actor_role == usuario_humano AND decision in [APROBAR, APROBAR_CON_EXCEPCION, RECHAZAR, SOLICITAR_CAMBIOS]",
        "authority": "solo_usuario_humano"
      },
      {
        "id": "AT-002",
        "from": "PENDIENTE",
        "to": "EXPIRADA",
        "event": "expiracion_alcanzada",
        "guard": "timestamp_actual >= expiration AND expiration != null",
        "authority": "accion_determinista"
      }
    ],
    "invariants": [
      "CONSUMIDA y EXPIRADA no tienen transiciones de salida.",
      "Una aprobacion CONSUMIDA no regresa a PENDIENTE ni acepta segunda decision.",
      "Una aprobacion EXPIRADA no puede pasar a CONSUMIDA ni recibir decision.",
      "Solo el usuario humano (actor_role == usuario_humano) puede emitir una decision."
    ]
  },
  "idempotency_rules": {
    "description": "Reglas deterministas de idempotencia para misiones, aprobaciones, checkpoints y eventos.",
    "same_key_same_content": {
      "action": "no_second_effect",
      "description": "Si la clave de idempotencia coincide y el contenido es identico al ya registrado, no se produce un segundo efecto. Se devuelve el resultado original sin crear nuevo registro."
    },
    "same_key_different_content": {
      "action": "conflict_rejection",
      "error_code": "INVALID_INPUT",
      "description": "Si la clave de idempotencia coincide pero el contenido difiere del ya registrado, se rechaza con error INVALID_INPUT. No se sobrescribe el registro existente."
    }
  },
  "approval_rules": {
    "valid_decisions": ["APROBAR", "APROBAR_CON_EXCEPCION", "RECHAZAR", "SOLICITAR_CAMBIOS"],
    "terminal_statuses": ["CONSUMIDA", "EXPIRADA"],
    "actor_role_required": "usuario_humano",
    "schema_scope": "JSON Schema valida estructura, tipos, enums, clave de idempotencia y restricciones de campos. La prevencion de doble respuesta sobre un registro ya CONSUMIDA se aplica mediante el ciclo de vida determinista entre registros en el runtime.",
    "decision_constraints": {
      "RECHAZAR": { "comment_required": true, "comment_pattern": "al menos un caracter no espacio" },
      "SOLICITAR_CAMBIOS": { "comment_required": true, "comment_pattern": "al menos un caracter no espacio" },
      "APROBAR_CON_EXCEPCION": { "conditions_min_items": 1, "condition_pattern": "al menos un caracter no espacio por condicion" }
    },
    "invariants": [
      "Una aprobacion CONSUMIDA no regresa a estado PENDIENTE.",
      "Una aprobacion CONSUMIDA no puede recibir una segunda decision (ciclo de vida entre registros).",
      "Una aprobacion EXPIRADA no puede pasar a CONSUMIDA (ciclo de vida entre registros).",
      "Misma clave de idempotencia y mismo contenido no genera segunda aprobacion.",
      "Misma clave de idempotencia y contenido diferente genera conflicto INVALID_INPUT.",
      "Solo el usuario humano (actor_role == usuario_humano) puede emitir una decision."
    ]
  }
}
