        "comment": "     ",
        "conditions": [],
        "expiration": null,
        "status": "CONSUMIDA",
        "idempotency_key": "idem-ainv-007"
      }
    },
    {
      "id": "AINV-008",
      "description": "EXPIRADA sin expiration — EXPIRADA exige expiration no null.",
      "expected_errors": [
